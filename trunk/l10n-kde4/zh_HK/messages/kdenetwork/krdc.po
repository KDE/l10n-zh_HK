msgstr "中等質素（DSL、有線、高速互聯網）"

#. i18n: tag string
#. i18n: file vnc/vncprefs.ui line 112
#: rc.cpp:336
msgid "Low Quality (Modem, ISDN, slow Internet)"
msgstr "低質素（數據機、ISDN、慢速互聯網）"


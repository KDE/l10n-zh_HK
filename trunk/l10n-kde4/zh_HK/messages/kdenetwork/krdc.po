#: rc.cpp:304
#, no-c-format
msgid "Medium Quality (DSL, Cable, fast Internet)"
msgstr "中等質素（DSL、有線、高速互聯網）"

#. i18n: tag string
#. i18n: file vnc/vncpreferences.ui line 41
#: rc.cpp:308
#, no-c-format

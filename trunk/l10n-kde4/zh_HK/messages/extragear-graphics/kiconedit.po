msgstr "顯示格線(&G)"

#: kiconedit.cpp:380
#, kde-format
msgid "Hide &Grid"
msgstr "隱藏格線(&G)"

#: kiconedit.cpp:381
#, kde-format
msgid ""
"Show grid\n"
"\n"
"Toggles the grid in the icon edit grid on/off"
msgstr ""
"顯示格線\n"
"\n"
"切換圖示編輯區的格線開關"

#: kiconedit.cpp:388
#, kde-format
msgid "Color Picker"
msgstr "顏色選取器"

#: kiconedit.cpp:392
#, kde-format
msgid ""
"Color Picker\n"
"\n"
"The color of the pixel clicked on will be the current draw color"
msgstr ""
"顏色選取器\n"
"\n"
"點按的像素顏色將成當前的畫畫顏色"

#: kiconedit.cpp:397
#, kde-format
msgid "Freehand"
msgstr "徒手"

#: kiconedit.cpp:401
#, kde-format
msgid ""
"Free hand\n"
"\n"
"Draw non-linear lines"
msgstr ""
"徒手\n"
"\n"
"徒手畫一非直線"

#: kiconedit.cpp:408
#, kde-format
msgid "Rectangle"
msgstr "矩形"

#: kiconedit.cpp:412
#, kde-format
msgid ""
"Rectangle\n"
"\n"
"Draw a rectangle"
msgstr ""
"矩形\n"
"\n"
"畫一矩形"

#: kiconedit.cpp:416
#, kde-format
msgid "Filled Rectangle"
msgstr "填滿的矩形"

#: kiconedit.cpp:420
#, kde-format
msgid ""
"Filled rectangle\n"
"\n"
"Draw a filled rectangle"
msgstr ""
"填滿的矩形\n"
"\n"
"畫一填滿的矩形"

#: kiconedit.cpp:424
#, kde-format
msgid "Circle"
msgstr "圓形"

#: kiconedit.cpp:428
#, kde-format
msgid ""
"Circle\n"
"\n"
"Draw a circle"
msgstr ""
"圓形\n"
"\n"
"畫一圓形"

#: kiconedit.cpp:432
#, kde-format
msgid "Filled Circle"
msgstr "填滿的圓形"

#: kiconedit.cpp:436
#, kde-format
msgid ""
"Filled circle\n"
"\n"
"Draw a filled circle"
msgstr ""
"填滿的圓形\n"
"\n"
"畫一填滿的圓形"

#: kiconedit.cpp:440
#, kde-format
msgid "Ellipse"
msgstr "橢圓"

#: kiconedit.cpp:444
#, kde-format
msgid ""
"Ellipse\n"
"\n"
"Draw an ellipse"
msgstr ""
"橢圓\n"
"\n"
"畫一橢圓"

#: kiconedit.cpp:448
#, kde-format
msgid "Filled Ellipse"
msgstr "填滿的橢圓"

#: kiconedit.cpp:452
#, kde-format
msgid ""
"Filled ellipse\n"
"\n"
"Draw a filled ellipse"
msgstr ""
"填滿的橢圓\n"
"\n"
"畫一填滿的橢圓"

#: kiconedit.cpp:456
#, kde-format
msgid "Spray"
msgstr "噴霧"

#: kiconedit.cpp:460
#, kde-format
msgid ""
"Spray\n"
"\n"
"Draw scattered pixels in the current color"
msgstr ""
"噴霧\n"
"\n"
"以當前顏色繪畫散落的像素"

#: kiconedit.cpp:465
#, kde-format
msgid "Flood Fill"
msgstr "填滿"

#: kiconedit.cpp:469
#, kde-format
msgid ""
"Flood fill\n"
"\n"
"Fill adjoining pixels with the same color with the current color"
msgstr ""
"填滿\n"
"\n"
"用當前的顏色填滿鄰接的像素"

#: kiconedit.cpp:474
#, kde-format
msgid "Line"
msgstr "線段"

#: kiconedit.cpp:478
#, kde-format
msgid ""
"Line\n"
"\n"
"Draw a straight line vertically, horizontally or at 45 deg. angles"
msgstr ""
"線段\n"
"\n"
"畫一垂直線、水平線、或45度線"

#: kiconedit.cpp:483
#, kde-format
msgid "Eraser (Transparent)"
msgstr "橡皮擦（透明化）"

#: kiconedit.cpp:487
#, kde-format
msgid ""
"Erase\n"
"\n"
"Erase pixels. Set the pixels to be transparent\n"
"\n"
"(Tip: If you want to draw transparency with a different tool, first click on "
"\"Erase\" then on the tool you want to use)"
msgstr ""
"清除\n"
"\n"
"清除像素。將像素設成透明的\n"
"\n"
"（提示：如果您想要用不同的工具來繪畫透明度，先按下「清除」再選取您要用的工"
"具）"

#: kiconedit.cpp:494
#, kde-format
msgid "Rectangular Selection"
msgstr "矩形選取"

#: kiconedit.cpp:498
#, kde-format
msgid ""
"Select\n"
"\n"
"Select a rectangular section of the icon using the mouse."
msgstr ""
"選取\n"
"\n"
"使用滑鼠在圖示上選取矩形。"

#: kiconedit.cpp:503
#, kde-format
msgid "Circular Selection"
msgstr "圓形選取"

#: kiconedit.cpp:507
#, kde-format
msgid ""
"Select\n"
"\n"
"Select a circular section of the icon using the mouse."
msgstr ""
"選取\n"
"\n"
"使用滑鼠在圖示上選取圓形。"

#: kiconedit.cpp:535
#, kde-format
msgid ""
"Statusbar\n"
"\n"
"The statusbar gives information on the status of the current icon. The "
"fields are:\n"
"\n"
"\t- Application messages\n"
"\t- Cursor position\n"
"\t- Size\n"
"\t- Zoom factor\n"
"\t- Number of colors"
msgstr ""
"狀態列\n"
"\n"
"狀態列提供目前圖示的資訊。欄位有:\n"
"\n"
"\t- 應用程式訊息\n"
"\t- 游標位置\n"
"\t- 大小\n"
"\t- 縮放倍率\n"
"\t- 顏色數"


#: hyperbola.cpp:234
msgid ""
"The Hyperbola and Parabola touch here\n"
"(%1)|(%2)"
msgstr ""
"雙曲線和抛物線在這裏相交\n"
"(%1)|(%2)"

#: hyperbola.cpp:254
msgid ""
"They touch here\n"
"(%1)|(%2)\n"
"and here\n"
"(%3)|(%4)\n"
"and here\n"
"(%5)|(%6)"
msgstr ""
"它們在以下位置相交：\n"
"(%1)|(%2)\n"
"(%3)|(%4)\n"
"(%5)|(%6)"

#: hyperbola.cpp:275
msgid ""
"The Hyperbola and line touch here\n"
"(%1|%2)"
msgstr ""
"雙曲線和直線在這裏相交\n"
"(%1|%2)"

#: hyperbola.cpp:281
msgid "The Hyperbola and line do not intersect"
msgstr "雙曲線和直線沒有交點"

#: hyperbola.cpp:298
msgid "The Hyperbola and line intersect here (%1|%2) and here (%3|%4)"
msgstr "雙曲線和直線相交於 (%1|%2) 和 (%3|%4)"


#: kfaximage.cpp:189
msgid "Unable to open file for reading."
msgstr "無法開啟檔案以讀取。"

#: kfaximage.cpp:194
msgid "Unable to read file header (file too short)."
msgstr "無法讀取檔案標題（檔案太短）。"

#: kfaximage.cpp:203
msgid "This is not a TIFF FAX file."
msgstr "這不是 TIFF 傳真檔案。"

#: kfaximage.cpp:228
msgid "Invalid or incomplete TIFF file."
msgstr "無效或不完整的 TIFF 檔案。"

#: kfaximage.cpp:329
msgid ""
"In file %1\n"
"StripsPerImage tag 273=%2,tag279=%3\n"
msgstr ""
"在 %1 檔案之中\n"
"StripsPerImage tag 273=%2,tag279=%3\n"

#: kfaximage.cpp:372
msgid ""
"Due to patent reasons LZW (Lempel-Ziv & Welch) compressed Fax files cannot be "
"loaded yet.\n"
msgstr ""
"由於專利原因，現時無法載入 LZW (Lempel-Ziv & Welch) 壓縮的傳真檔案。\n"

#: kfaximage.cpp:377
msgid ""
"This version can only handle Fax files\n"
msgstr ""
"此版本只能處理傳真檔案\n"

#: kfaximage.cpp:406
msgid "%1: Bad Fax File"
msgstr "%1: 不良的傳真檔案"


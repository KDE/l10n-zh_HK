#: kcm_krfb.cpp:60
msgid "Desktop Sharing Control Module"
msgstr "桌面分享控制模組"

#: kcm_krfb.cpp:62
msgid "Configure desktop sharing"
msgstr "設定桌面分享"

#: kcm_krfb.cpp:63

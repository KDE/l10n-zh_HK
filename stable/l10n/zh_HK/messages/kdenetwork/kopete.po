msgstr "你的 MSN 收件匣有一個來自 %1 的新電子郵件。"

#: protocols/msn/msnnotifysocket.cpp:903
msgid "Now Listening: ♫ %1 ♫"
msgstr "正在聆聽: ♫ %1 ♫"

#: protocols/msn/msnsocket.cpp:184
msgid ""
"There was an error while connecting to the MSN server.\n"
"Error message:\n"
msgstr ""
"連接 MSN 伺服器時發生錯誤。\n"
"錯誤訊息:\n"

#: protocols/msn/msnsocket.cpp:186
#, c-format
msgid "Unable to lookup %1"
msgstr "無法查找 %1"

#: protocols/msn/msnsocket.cpp:568
msgid "An internal server error occurred. Please try again later."
msgstr "發生伺服器內部錯誤。請稍後再試。"

#: protocols/msn/msnsocket.cpp:571
msgid ""
"It is no longer possible to perform this operation. The MSN server does not "
"allow it anymore."
msgstr "現在已不能進行這種操作。 MSN 伺服器已不再容許。"

#: protocols/msn/msnsocket.cpp:577
msgid "The MSN server is busy. Please try again later."
msgstr "MSN 伺服器忙碌。請稍後再試。"

#: protocols/msn/msnsocket.cpp:586
msgid "The server is not available at the moment. Please try again later."
msgstr "伺服器現在不能用。請稍後再試。"

#: protocols/msn/msnsocket.cpp:590
msgid ""
"Unhandled MSN error code %1 \n"
"Please fill a bug report with a detailed description and if possible the last "
"console debug output."
msgstr ""

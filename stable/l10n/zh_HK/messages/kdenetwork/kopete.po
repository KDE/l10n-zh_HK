msgid "Home Page"
msgstr "網頁"

#: protocols/irc/ircprotocol.cpp:133
msgid "IRC User"
msgstr "IRC 用戶"

#: protocols/irc/ircprotocol.cpp:134
msgid "IRC Server"
msgstr "IRC 伺服器"

#: protocols/irc/ircprotocol.cpp:135
msgid "IRC Channels"
msgstr "IRC 頻道"

#: protocols/irc/ircprotocol.cpp:136
msgid "IRC Hops"
msgstr "IRC 中繼段"

#: protocols/irc/ircprotocol.cpp:138
msgid "User Is Authenticated"
msgstr "用戶已認證"

#: protocols/irc/ircprotocol.cpp:150
msgid "USAGE: /raw <text> - Sends the text in raw form to the server."
msgstr "用法: /raw <文字> - 以原始方式傳送文字到伺服器。"

#: protocols/irc/ircprotocol.cpp:154
msgid "USAGE: /quote <text> - Sends the text in quoted form to the server."
msgstr "用法: /quote <文字> - 以加引號方式傳送文字到伺器。"

#: protocols/irc/ircprotocol.cpp:158
msgid "USAGE: /ctcp <nick> <message> - Send the CTCP message to nick<action>."
msgstr "用法: /ctcp <暱稱> <訊息> - 傳送 CTCP 訊息至暱稱<行動>。"

#: protocols/irc/ircprotocol.cpp:162
msgid "USAGE: /ping <nickname> - Alias for /CTCP <nickname> PING."
msgstr "用法: /ping <暱稱> - /CTCP <暱稱> PING 的別名。"

#: protocols/irc/ircprotocol.cpp:166
msgid ""
"USAGE: /motd [<server>] - Shows the message of the day for the current or the "
"given server."
msgstr "用法: /motd <伺服器> - 顯示當前或指定伺服器的每日訊息。"

#: protocols/irc/ircprotocol.cpp:170
msgid "USAGE: /list - List the public channels on the server."
msgstr "用法: /list - 列出伺服器上的公眾頻道。"

#: protocols/irc/ircprotocol.cpp:174
msgid "USAGE: /join <#channel 1> [<password>] - Joins the specified channel."
msgstr "用法: /join <#頻道 1> [<密碼>] - 加入指定頻道。"

#: protocols/irc/ircprotocol.cpp:178
msgid ""
"USAGE: /topic [<topic>] - Sets and/or displays the topic for the active "
"channel."
msgstr "用法: /topic [<主題>] - 設定及/或顯示當前頻的主題。"

#: protocols/irc/ircprotocol.cpp:183
msgid "USAGE: /whois <nickname> - Display whois info on this user."
msgstr "用法: /whois <暱稱> - 顯示此用戶的 whois 資訊。"

#: protocols/irc/ircprotocol.cpp:187
msgid "USAGE: /whowas <nickname> - Display whowas info on this user."
msgstr "用法: /whowas <暱稱> - 顯示此用戶的 whowas 資訊。"

#: protocols/irc/ircprotocol.cpp:191
msgid "USAGE: /who <nickname|channel> - Display who info on this user/channel."
msgstr "用法: /who <暱稱|頻道> - 顯示此用戶/頻道的 who 資訊。"

#: protocols/irc/ircprotocol.cpp:195
msgid ""
"USAGE: /query <nickname> [<message>] - Open a private chat with this user."
msgstr "用法: /query <暱稱> [<訊息>] - 開啟此用戶的私人聊天。"

#: protocols/irc/ircprotocol.cpp:199
msgid "USAGE: /mode <channel> <modes> - Set modes on the given channel."
msgstr "用法: /mode <頻道> <模式> - 設定特定頻道的模式。"

#: protocols/irc/ircprotocol.cpp:203
msgid "USAGE: /nick <nickname> - Change your nickname to the given one."
msgstr "用法: /nick <暱稱> - 更改你的暱稱。"

#: protocols/irc/ircprotocol.cpp:207
msgid "USAGE: /me <action> - Do something."
msgstr "用法: /me <行動> - 做些事情。"

#: protocols/irc/ircprotocol.cpp:211
msgid "USAGE: /ame <action> - Do something in every open chat."
msgstr "用法: /ame <行動> - 在每個聊天視窗做些事情。"

#: protocols/irc/ircprotocol.cpp:215
msgid ""
"USAGE: /kick <nickname> [<reason>] - Kick someone from the channel (requires "
"operator status)."
msgstr "用法: /kick <暱稱> [<理由>] - 將某人踢出頻道（需要操作員狀態）。"

#: protocols/irc/ircprotocol.cpp:220
msgid ""
"USAGE: /ban <mask> - Add someone to this channel's ban list. (requires operator "
"status)."
msgstr "用法: /ban <遮罩> - 將某人加至此頻道的封鎖清單（需要操作員狀態）。"

#: protocols/irc/ircprotocol.cpp:225
msgid ""
"USAGE: /bannick <nickname> - Add someone to this channel's ban list. Uses the "
"hostmask nickname!*@* (requires operator status)."
msgstr "用法: /bannick <暱稱> - 將某人加至此頻道的封鎖清單。使用 hostmask nickname!*@*（需要操作員狀態）。"

#: protocols/irc/ircprotocol.cpp:229
msgid ""
"USAGE: /op <nickname 1> [<nickname 2> <...>] - Give channel operator status to "
"someone (requires operator status)."
msgstr "用法: /op <暱稱 1> [<暱稱 1> <...>] - 將操作員狀態加給某人（需要操作員狀態）。"

#: protocols/irc/ircprotocol.cpp:234
msgid ""
"USAGE: /deop <nickname> [<nickname 2> <...>]- Remove channel operator status "
"from someone (requires operator status)."
msgstr "用法: /deop <暱稱 1> [<暱稱 1> <...>] - 移除某人的操作員狀態（需要操作員狀態）。"

#: protocols/irc/ircprotocol.cpp:238
msgid ""
"USAGE: /voice <nickname> [<nickname 2> <...>]- Give channel voice status to "
"someone (requires operator status)."
msgstr "用法: /voice <暱稱 1> [<暱稱 1> <...>] - 將頻道話音狀態加給某人（需要操作員狀態）。"

#: protocols/irc/ircprotocol.cpp:243
msgid ""
"USAGE: /devoice <nickname> [<nickname 2> <...>]- Remove channel voice status "
"from someone (requires operator status)."
msgstr "用法: /devoice <暱稱 1> [<暱稱 1> <...>] - 移除某人的頻道話音狀態（需要操作員狀態）。"

#: protocols/irc/ircprotocol.cpp:247
msgid ""
"USAGE: /quit [<reason>] - Disconnect from IRC, optionally leaving a message."
msgstr "用法: /quit [<理由>] - 中斷 IRC 連線，可選擇性地離下訊息。"

#: protocols/irc/ircprotocol.cpp:251
msgid ""
"USAGE: /part [<reason>] - Part from a channel, optionally leaving a message."
msgstr "用法: /part [<理由>] - 離開某一頻道，可選擇性地離下訊息。"

#: protocols/irc/ircprotocol.cpp:255
msgid ""
"USAGE: /invite <nickname> [<channel>] - Invite a user to join a channel."
msgstr "用法: /invite [<理由>] [<頻道>] - 邀請用戶加入頻道。"

#: protocols/irc/ircprotocol.cpp:259
msgid "USAGE: /j <#channel 1> [<password>] - Alias for JOIN."
msgstr "用法: /j <#頻道 1> [<密碼>] - JOIN 的別名。"

#: protocols/irc/ircprotocol.cpp:264
msgid ""
"USAGE: /msg <nickname> [<message>] - Alias for QUERY <nickname> <message>."
msgstr "用法: /msg <暱稱> [<訊息>] - QUERY <暱稱> <訊息> 的別名。"

#: protocols/irc/ircprotocol.cpp:429 protocols/irc/ircprotocol.cpp:442
msgid "You must enter some text to send to the server."
msgstr "你必須輸入傳給伺服器的一些文字。"

#: protocols/irc/ircprotocol.cpp:490 protocols/irc/ircprotocol.cpp:690
msgid "You must be in a channel to use this command."
msgstr "你必須在頻道中才能使用此指令。"

#: protocols/irc/ircprotocol.cpp:547 protocols/irc/ircprotocol.cpp:651
#: protocols/irc/ircprotocol.cpp:668 protocols/irc/ircprotocol.cpp:733

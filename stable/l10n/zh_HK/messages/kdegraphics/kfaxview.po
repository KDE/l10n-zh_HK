#: faxmultipage.cpp:62
msgid "KViewshell Fax Plugin."
msgstr "KViewshell 傳真插件。"

#: faxmultipage.cpp:65
msgid "This program previews fax (g3) files."
msgstr "此程式用來預覽傳真 (g3) 檔案。"

#: faxmultipage.cpp:68
msgid "Current Maintainer."
msgstr "當前維護者。"

#: faxmultipage.cpp:80
msgid "*.g3|Fax (g3) file (*.g3)"

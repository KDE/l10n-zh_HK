#. i18n: file kuser.kcfg line 205
#: rc.cpp:409
#, no-c-format
msgid "LDAP User container"
msgstr ""

#. i18n: file kuser.kcfg line 206
#: rc.cpp:412
#, no-c-format
msgid ""
"This specifies where to store users' entries relative to the LDAP base DN."
msgstr "此處指定用戶項目相對 LDAP 基礎 DN 的儲存位置。"

#. i18n: file kuser.kcfg line 210
#: rc.cpp:415
#, no-c-format
msgid "LDAP User filter"
msgstr "LDAP 用戶過濾器"

#. i18n: file kuser.kcfg line 211
#: rc.cpp:418
#, no-c-format
msgid "This specifies the filter used for user entries."
msgstr "此處指定用於用戶項目的過濾器。"

#. i18n: file kuser.kcfg line 214
#: rc.cpp:421
#, no-c-format
msgid "LDAP Group container"
msgstr ""

#. i18n: file kuser.kcfg line 215
#: rc.cpp:424
#, no-c-format
msgid ""
"This specifies where to store groups' entries relative to the LDAP base DN."
msgstr "此處指定群組項目相對 LDAP 基礎 DN 的儲存位置。"

#. i18n: file kuser.kcfg line 219
#: rc.cpp:427
#, no-c-format
msgid "LDAP Group filter"
msgstr "LDAP 群組過濾器"

#. i18n: file kuser.kcfg line 220
#: rc.cpp:430
#, no-c-format
msgid "This specifies the filter used for group entries."
msgstr "此處指定用於群組項目的過濾器。"

#. i18n: file kuser.kcfg line 223
#: rc.cpp:433
#, no-c-format
msgid "LDAP User RDN prefix"
msgstr "LDAP 用戶 RDN 前置字元"

#. i18n: file kuser.kcfg line 224
#: rc.cpp:436
#, no-c-format
msgid "This specifies what prefix will used for user entries."
msgstr "此處指定用於用戶項目的前置字元。"

#. i18n: file kuser.kcfg line 234
#: rc.cpp:442
#, no-c-format
msgid ""
"Check this if the user's full name should be stored in the cn (Canonical Name) "
"attribute."
msgstr ""

#. i18n: file kuser.kcfg line 238
#: rc.cpp:445
#, no-c-format
msgid "Update the gecos field"
msgstr "更新 gecos 欄位"

#. i18n: file kuser.kcfg line 239
#: rc.cpp:448
#, no-c-format
msgid "Check this if the gecos attribute should be updated."
msgstr ""

#. i18n: file kuser.kcfg line 243
#: rc.cpp:451
#, no-c-format
msgid "Manage LDAP shadowAccount objectclass"
msgstr ""

#. i18n: file kuser.kcfg line 244
#: rc.cpp:454
#, no-c-format
msgid ""
"Check this if the shadowAccount object should be used in the users' entries. It "
"allows to enforce password change/expiration policies."
msgstr ""

#. i18n: file kuser.kcfg line 248
#: rc.cpp:457
#, no-c-format
msgid "LDAP Structural objectclass"
msgstr ""

#. i18n: file kuser.kcfg line 249
#: rc.cpp:460
#, no-c-format
msgid ""
"This option allows to specify the structural objectclass used with users' "
"entries. If you want to use these entries not just for authentication, but for "
"an addressbook, too, then choose inetOrgPerson."
msgstr ""

#. i18n: file kuser.kcfg line 257
#: rc.cpp:463
#, no-c-format
msgid "LDAP Group RDN prefix"
msgstr "LDAP 群組 RDN 前置字元"

#. i18n: file kuser.kcfg line 258
#: rc.cpp:466
#, no-c-format
msgid "This specifies what prefix will used for group entries."
msgstr "此處指定用於群組項目的前置字元。"

#. i18n: file kuser.kcfg line 266
#: rc.cpp:469
#, no-c-format
msgid "LDAP Password hash method"
msgstr "LDAP 密碼雜湊（hash）方法"

#. i18n: file kuser.kcfg line 267
#: rc.cpp:472
#, no-c-format
msgid "This specifies the password hashing method. The most secure is SSHA."
msgstr ""

#. i18n: file kuser.kcfg line 279
#: rc.cpp:475
#, no-c-format
msgid "Enable samba account management"
msgstr "啟用 samba 帳號管理"

#. i18n: file kuser.kcfg line 280
#: rc.cpp:478
#, no-c-format
msgid ""
"Check this if you want to use the user/group entries in a Samba domain. KUser "
"will create sambaSamAccount objectclass for each entry which is usable with the "
"ldapsam passdb backend with Samba version greater than 3.0."
msgstr ""

#. i18n: file kuser.kcfg line 283
#: rc.cpp:481
#, no-c-format
msgid "Samba domain name"
msgstr "Samba 網域名稱"

#. i18n: file kuser.kcfg line 284
#: rc.cpp:484
#, no-c-format
msgid "This specifies the samba domain name."
msgstr ""

#. i18n: file kuser.kcfg line 287
#: rc.cpp:487
#, no-c-format
msgid "Samba domain SID"
msgstr "Samba 網域 SID"

#. i18n: file kuser.kcfg line 288
#: rc.cpp:490
#, no-c-format
msgid ""
"This specifies the domain Security IDentifier. It is unique in a single domain. "
"You can query the value of the domain SID with 'net getlocalsid domain_name'."
msgstr ""

#. i18n: file kuser.kcfg line 291
#: rc.cpp:493
#, no-c-format
msgid "Algorithmic RID base"
msgstr "算法 RID 基礎"

#. i18n: file kuser.kcfg line 292
#: rc.cpp:496
#, no-c-format
msgid ""
"This value is an offset for the algorithmic mapping from uids and gids to rids. "
"The default (and minimum) value is 1000, it must be even, and the LDAP database "
"and smb.conf must store the same values."
msgstr ""

#. i18n: file kuser.kcfg line 296
#: rc.cpp:499
#, no-c-format
msgid "Samba login script"
msgstr ""

#. i18n: file kuser.kcfg line 297
#: rc.cpp:502
#, no-c-format
msgid ""
"This specifies a name of a login script (in the `Netlogon` share) which will be "
"executed as the user logs in to a Windows machine."
msgstr ""

#. i18n: file kuser.kcfg line 300
#: rc.cpp:505
#, no-c-format
msgid "Samba home drive"
msgstr "Samba 家磁碟機"

#. i18n: file kuser.kcfg line 301
#: rc.cpp:508
#, no-c-format
msgid ""
"Specifies a drive letter where the user's home directory will automatically "
"mapped when he/she logs into a Windows machine."
msgstr ""

#. i18n: file kuser.kcfg line 304
#: rc.cpp:511
#, no-c-format
msgid "Samba profile path template"
msgstr "Samba profile 路徑樣板"

#. i18n: file kuser.kcfg line 305
#: rc.cpp:514
#, no-c-format
msgid ""
"This specifies the location of the roaming profile of the user. The '%U' macro "
"will be replaced with the actual user name."
msgstr ""

#. i18n: file kuser.kcfg line 308
#: rc.cpp:517
#, no-c-format
msgid "Samba home path template"
msgstr "Samba 家路徑樣板"

#. i18n: file kuser.kcfg line 309
#: rc.cpp:520
#, no-c-format
msgid ""
"This specifies the location of the home directory of the user. This field is "
"meaningful only for Windows machines. The '%U' macro will be replaced with the "
"actual user name."
msgstr ""

#. i18n: file kuser.kcfg line 313
#: rc.cpp:526
#, no-c-format
msgid ""
"Store the LanManager hashed password in the sambaLMPassword attribute. Check "
"this if you have older clients (Win9x series and before) on your network."
msgstr ""

